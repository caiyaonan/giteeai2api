# Docker Compose 宿主机映射端口（Docker 部署改这里即可）
PORT=8080

# 本地直接运行二进制时的监听地址（Docker 内固定为 :8080）
ADDR=:8080

# 数据目录（SQLite 数据库 + 临时图片缓存）
DATA_DIR=./data

# 管理后台登录密码（务必修改）
ADMIN_PASSWORD=admin123

# 可选：静态客户端 API Key，逗号分隔（也可在管理后台动态创建）
API_KEYS=

# Gitee AI 上游配置
UPSTREAM_BASE=https://ai.gitee.com/v1
DEFAULT_MODEL=z-image-turbo
EDIT_MODEL=Qwen-Image-Edit

# 可选：自定义模型映射，逗号分隔，例如 my-model=z-image-turbo
MODEL_MAP=

# 令牌池与并发调度
TOKEN_DAILY_LIMIT=100
TOKEN_CONCURRENCY=2
MAX_RETRIES=3
QUEUE_TIMEOUT_SEC=60
UPSTREAM_TIMEOUT_SEC=180

# 生图默认参数
DEFAULT_SIZE=1024x1024
MAX_SIDE=2048
QUALITY_STEPS=low=6,medium=9,high=12
DEFAULT_NEGATIVE_PROMPT=

# 当 response_format=url 时用于拼接图片访问地址（留空则自动根据请求 Host 推断）
PUBLIC_BASE_URL=
IMAGE_TTL_HOURS=24
LOG_RETENTION_DAYS=30
